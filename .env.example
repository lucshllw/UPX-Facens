# Modelo sem credenciais reais. Prefira gerar com node tools/setup-env.js.
POSTGRES_DB=reuseplus
POSTGRES_USER=reuseplus
DB_PASSWORD=SUBSTITUA_POR_SENHA_ALEATORIA
JWT_SECRET=SUBSTITUA_POR_CHAVE_ALEATORIA_COM_PELO_MENOS_64_BYTES
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Para rodar o JAR fora do Compose, configure tambem:
# DB_URL=jdbc:postgresql://HOST:5432/reuseplus?sslmode=require
# DB_USER=reuseplus
# UPLOAD_DIRECTORY=/caminho/volume-persistente/uploads
